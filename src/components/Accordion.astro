---
const { title, ...rest } = Astro.props;
---

<details {...rest}>
  <summary>{title}</summary>
  <div class="content"><slot /></div>
</details>

<style>
details {
  border-bottom: 1px solid #eee;
}

summary {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16px;
  padding: 14px 0;
  font-size: 13px;
  line-height: 1.5;
  color: #111;
  cursor: pointer;
  list-style: none;
}

summary::-webkit-details-marker {
  display: none;
}

summary::after {
  content: '+';
  flex: 0 0 auto;
  color: #bbb;
}

details[open] summary::after {
  content: '−';
}

summary:hover,
details[open] summary,
details[open] summary::after {
  color: var(--accent-color);
}

.content {
  padding: 0 0 16px;
  font-size: 13px;
  line-height: 1.6;
  color: #555;
  max-width: 60ch;
}
</style>
