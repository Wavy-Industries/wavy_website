---
import '../styles/global.css';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  type?: 'highlight' | 'default';
  theme?: 'light' | 'dark';
}

const { href, type = 'default', theme = 'light', ...rest } = Astro.props;
---

<a href={href} class:list={[type, theme]} {...rest}>
  <slot />
</a>

<style>
a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  font-style: normal;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.02em;
  padding: 9px 18px;
  border: 0;
  border-radius: 3px;
  transition: background-color 0.15s;
}

a:hover {
  text-decoration: none;
}

.highlight {
  background-color: #57d865;
  color: #111;
}
.highlight:hover {
  background-color: #48ce57;
}

.default.light {
  background-color: #f0f0f0;
  color: #111;
}
.default.light:hover {
  background-color: #e4e4e4;
}

.default.dark {
  background-color: rgba(255, 255, 255, 0.12);
  color: #fff;
}
.default.dark:hover {
  background-color: rgba(255, 255, 255, 0.2);
}
</style>
