---
import '../styles/global.css';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  type?: 'highlight' | 'default';
  theme?: 'light' | 'dark';
}

const { href, type = 'default', theme = 'light', ...rest } = Astro.props;
---

<a href={href} class:list={[type, theme]} {...rest}>
  <slot />
</a>

<style>
a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 20px;
  font-size: 13px;
  font-weight: 500;
  font-style: normal;
  letter-spacing: 0.02em;
  text-decoration: none;
  border: 0;
}

a:hover {
  text-decoration: none;
  background-color: var(--accent-color);
  color: #fff;
}

.default.light {
  background-color: #111;
  color: #fff;
}

.default.dark {
  background-color: #fff;
  color: #111;
}

.highlight {
  background-color: #57d865;
  color: #111;
}
</style>
