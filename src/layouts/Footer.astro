---
import '../styles/global.css';
import { routes } from '../routes';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'footer'> {
    variant?: 'light' | 'dark';
}

const { variant = 'light', ...rest } = Astro.props as Props;

let year = new Date().getFullYear();
---

<footer class={variant} {...rest}>
    <div class="footer-inner">
        <div class="footer-company">
            <div class="company-name">Wavy Industries AS</div>
            <address class="company-address">
                Rosteds gate 15a<br />
                0178 Oslo<br />
                Norway
            </address>
            <div class="company-meta">
                <span>© {year}</span>
                <span>Org nr. 935955335</span>
                <a id="something-special-footer-a"><span id="something-special-footer"></span></a>
            </div>
        </div>

        <nav class="footer-links" aria-label="Footer">
            <a href={routes.about}>about</a>
            <a href={routes.wavyDiscord} target="_blank">discord</a>
            <a href={routes.wavyIndstagram} target="_blank">instagram</a>
            <button type="button" id="footer-newsletter-trigger">newsletter</button>
            <a href={routes.termsAndConditions}>terms &amp; conditions</a>
        </nav>
    </div>
</footer>

<style>
footer {
    display: flex;
    align-items: end;
    height: auto;
}

footer[hide] {
    height: 0;
    padding: 0;
    overflow: hidden;
}

.footer-inner {
    width: 100%;
    box-sizing: border-box;
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 28px;
    font-style: normal;
    font-size: 13px;
    font-weight: 400;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
}

footer.light {
    background-color: #fff;
    color: #555;
    border-top: 1px solid #eaeaea;
}

footer.dark {
    background-color: #0d0d0d;
    color: #bdbdbd;
    border-top: 1px solid #1f1f1f;
}

.footer-company {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
}

.company-name {
    color: inherit;
}

.company-address {
    font-style: normal;
    line-height: 1.55;
    color: inherit;
}

.company-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 12px;
    color: #bbb;
}

footer.dark .company-meta {
    color: #777;
}

.footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
}

.footer-links a,
.footer-links button,
#something-special-footer-a {
    color: inherit;
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    font-style: normal;
    line-height: 1.5;
    cursor: pointer;
}

footer.light .footer-links a:hover,
footer.light .footer-links button:hover,
footer.light #something-special-footer-a:hover {
    color: var(--accent-color);
}

footer.dark .footer-links a:hover,
footer.dark .footer-links button:hover,
footer.dark #something-special-footer-a:hover {
    color: #fff;
}

@media (max-width: 560px) {
    .footer-inner {
        padding: 24px 20px;
        gap: 24px;
    }

    .footer-links {
        align-items: flex-start;
        text-align: left;
    }
}
</style>

<script>
import { openNewsletter } from '~/lib/state/newsletter.svelte';

function doSomethingSpecial() {
    let special = document.getElementById('something-special-footer');
    let specialA = document.getElementById('something-special-footer-a') as HTMLAnchorElement;
    let special1 = "hell"
    let special2 = "o"
    special.innerHTML = special1 + special2 + "@"+ "wavyindustries.com";
    specialA.href = "mai" + "lto:" + special1 + special2 + "@" + "wavyindustries.com";
}
setTimeout(doSomethingSpecial, 100);

document.getElementById('footer-newsletter-trigger')?.addEventListener('click', () => openNewsletter('footer_popup'));
</script>
