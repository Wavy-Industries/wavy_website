---
import '../styles/global.css';
import { routes } from '../routes';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'footer'> {
    variant?: 'light' | 'dark';
}

const { variant = 'light', ...rest } = Astro.props as Props;

// get the current year
let year = new Date().getFullYear();

// images
import discordImg from '../assets/icons/Discord blue mark.svg';
import instagramImg from '../assets/icons/instagram.svg';
---

<footer class={variant} {...rest}>
    <div class="footer-inner">
        <div class="footer-company">
            <div class="company-name">Wavy Industries AS</div>
            <address class="company-address">
                Rosteds gate 15a<br />
                0178 Oslo<br />
                Norway
            </address>
            <div class="company-meta">
                <span>© {year}</span>
                <span>Org nr. 935955335</span>
                <a id="something-special-footer-a"><span id="something-special-footer"></span></a>
            </div>
        </div>

        <nav class="footer-links" aria-label="Footer">
            <a href={routes.about}>About</a>
            <a href={routes.termsAndConditions}>Terms &amp; Conditions</a>
            <button type="button" class="newsletter-trigger" id="footer-newsletter-trigger">Newsletter</button>
            <div class="footer-social">
                <a href={routes.wavyDiscord} target="_blank" aria-label="Discord"><img alt="" src={discordImg.src} /></a>
                <a href={routes.wavyIndstagram} target="_blank" aria-label="Instagram"><img alt="" src={instagramImg.src} /></a>
            </div>
        </nav>
    </div>
</footer>

<style>
footer {
    display: flex;
    align-items: end;
    height: auto;
}

footer[hide] {
    height: 0;
    padding: 0;
    overflow: hidden;
}

.footer-inner {
    width: 100%;
    box-sizing: border-box;
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 28px;
    font-style: normal;
    font-size: 14px;
    font-weight: 300;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
}

/* Light theme (default) */
footer.light {
    background-color: #ffffff;
    color: #333;
    border-top: 1px solid #eaeaea;
}

footer.light img {
    filter: brightness(0%);
}

/* Dark theme */
footer.dark {
    background-color: #0d0d0d;
    color: #bdbdbd;
    border-top: 1px solid #1f1f1f;
}

footer.dark img {
    filter: none;
}

.footer-company {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
}

.company-name {
    font-weight: 500;
    color: inherit;
}

.company-address {
    font-style: normal;
    line-height: 1.55;
    color: inherit;
    opacity: 0.85;
}

.company-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 12px;
    opacity: 0.7;
}

.footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    text-align: right;
}

.footer-links a,
.footer-links button {
    color: inherit;
    text-decoration: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    cursor: pointer;
    line-height: 1.4;
}

.footer-links a:hover,
.footer-links button:hover {
    text-decoration: underline;
}

.footer-social {
    display: flex;
    gap: 16px;
    margin-top: 4px;
}

.footer-social a {
    display: inline-flex;
    align-items: center;
    opacity: 0.75;
    transition: opacity 0.15s;
}

.footer-social a:hover {
    opacity: 1;
}

.footer-social img {
    height: 16px;
    width: auto;
}

#something-special-footer-a {
    color: inherit;
    text-decoration: none;
}

#something-special-footer-a:hover {
    text-decoration: underline;
}

@media (max-width: 560px) {
    .footer-inner {
        padding: 24px 20px;
        gap: 24px;
    }

    .footer-links {
        align-items: flex-start;
        text-align: left;
    }
}
</style>

<script>
import { openNewsletter } from '~/lib/state/newsletter.svelte';

function doSomethingSpecial() {
    let special = document.getElementById('something-special-footer');
    let specialA = document.getElementById('something-special-footer-a') as HTMLAnchorElement;
    let special1 = "hell"
    let special2 = "o"
    special.innerHTML = special1 + special2 + "@"+ "wavyindustries.com";
    specialA.href = "mai" + "lto:" + special1 + special2 + "@" + "wavyindustries.com";
}
setTimeout(doSomethingSpecial, 100);

document.getElementById('footer-newsletter-trigger')?.addEventListener('click', () => openNewsletter('footer_popup'));
</script>
