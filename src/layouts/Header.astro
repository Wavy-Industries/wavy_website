---
interface Props {
	textColor?: 'black' | 'white';
    hide?: boolean;
}

const { textColor = 'black', hide = false } = Astro.props;

import { routes } from '../routes';
import '../styles/global.css';
import { getCollection } from 'astro:content';

const currentPage = new URL(Astro.request.url).pathname.replace(/\/$/, '').replace(/\.html$/, "");

function currentPageCheck(link) {
    const regex = new RegExp(`^${link}(/|$)`);
    return regex.test(currentPage) ? "active-link" : "";
}

function parseBlogDateFromId(id: string): Date | null {
    const m = /^(\d{4})([.\-]?)(\d{2})\2(\d{2})/.exec(id);
    if (!m) return null;
    const [, y, , mth, d] = m;
    const dt = new Date(Number(y), Number(mth) - 1, Number(d));
    return isNaN(dt.getTime()) ? null : dt;
}

// Build-time: find the latest blog post date and bake it into the HTML.
// The 7-day freshness cap is evaluated at visit time in the client script
// below, so a stale build can never show a dot for a post outside the window.
let latestBlogDateMs: number | null = null;
try {
    const blogPosts = await getCollection('blog');
    for (const p of blogPosts) {
        const fallback = parseBlogDateFromId(p.id);
        const dRaw = p.data.date ?? fallback;
        if (!dRaw) continue;
        const ms = new Date(dRaw).getTime();
        if (Number.isFinite(ms) && (latestBlogDateMs === null || ms > latestBlogDateMs)) {
            latestBlogDateMs = ms;
        }
    }
} catch {}
const latestBlogIso = latestBlogDateMs !== null ? new Date(latestBlogDateMs).toISOString() : '';

import logoImg from '../assets/logo.svg';
import logoWhiteImg from '../assets/logo-white.svg';

import CartLink from '../components/CartLink.svelte';
import CartPanel from '../components/CartPanel.svelte';
import NewsletterPopup from '../components/NewsletterPopup.svelte';
---

<header class={textColor == 'white' ? 'text-white' : 'text-black'} {...(hide ? { hide: true } : {})}>
    <nav class="products" aria-label="Products">
        <ul>
            <li class={currentPageCheck(routes.monkey)}>
                <a href={routes.monkey}>MON<b>KEY</b></a>
            </li>
            <!-- BRIDGE is unannounced. Page lives at src/pages/_bridge.astro. -->
            <!-- <li class={currentPageCheck(routes.bridge)}>
                <a href={routes.bridge}>BRIDGE</a><span class="flag-new">new</span>
            </li> -->
            <li class={currentPageCheck(routes.kd3)}>
                <a href={routes.kd3}>KD-3</a>
            </li>
        </ul>
    </nav>

    <a class="logo" href={routes.home} aria-label="Wavy Industries">
        <img src={textColor == 'white' ? logoWhiteImg.src : logoImg.src} alt="Wavy Industries" />
    </a>

    <nav class="utility" aria-label="Site">
        <ul>
            <li class={currentPageCheck(routes.about)}>
                <a href={routes.about}>about</a>
            </li>
            <li class={currentPageCheck(routes.blog)} data-blog-link data-latest-blog={latestBlogIso}>
                <a href={routes.blog}>blog{latestBlogIso && <span class="blog-dot" hidden></span>}</a>
            </li>
            <li class={currentPageCheck(routes.support)}>
                <a href={routes.support}>support</a>
            </li>
            <li class={currentPageCheck(routes.partners)}>
                <a href={routes.partners}>partners</a>
            </li>
            <li>
                <CartLink client:load />
            </li>
        </ul>
    </nav>

    <CartPanel client:load />
    <NewsletterPopup client:load />
</header>

<style>
    header {
        padding: 18px 24px;
        width: 100%;

        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 24px;

        font-size: 12px;
        font-weight: 400;
        letter-spacing: 0.02em;

        transition: all 0.3s;
        height: auto;
    }

    header[hide] {
        height: 0;
        padding-top: 0;
        padding-bottom: 0;
        overflow: hidden;
    }

    .text-black {
        color: black;
    }
    .text-white {
        color: rgba(255, 255, 255, 0.9);
    }

    nav > ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 20px;
        align-items: baseline;
    }

    .products {
        grid-column: 1;
        justify-self: start;
    }

    .logo {
        grid-column: 2;
        justify-self: center;
        display: block;
    }

    .logo img {
        display: block;
        width: 56px;
        height: auto;
    }

    .utility {
        grid-column: 3;
        justify-self: end;
    }

    li {
        white-space: nowrap;
    }

    a {
        color: inherit;
        text-decoration: none;
        font-style: normal;
    }

    a:hover {
        text-decoration: underline;
    }

    .active-link > a {
        text-decoration: underline;
    }

    /* Blinking "new" marker on BRIDGE. step-end makes it a hard on/off
       toggle rather than a fade. */
    .flag-new {
        margin-left: 3px;
        font-size: 9px;
        vertical-align: super;
        animation: flag-blink 2s step-end infinite;
    }

    @keyframes flag-blink {
        0% { opacity: 1; }
        50% { opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .flag-new {
            animation: none;
            opacity: 1;
        }
    }

    [data-blog-link] a {
        position: relative;
    }

    .blog-dot {
        position: absolute;
        top: -1px;
        right: -7px;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #ff7a1a;
    }

    .blog-dot[hidden] {
        display: none;
    }

    @media (max-width: 760px) {
        header {
            grid-template-columns: 1fr;
            justify-items: center;
            gap: 14px;
            padding: 16px;
        }

        .products,
        .logo,
        .utility {
            grid-column: 1;
            justify-self: center;
        }

        .logo {
            grid-row: 1;
        }

        .products {
            grid-row: 2;
        }

        .utility {
            grid-row: 3;
        }

        nav > ul {
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px 16px;
        }
    }
</style>

<script>
    const STORAGE_KEY = 'wavy_blog_last_seen';
    const NEW_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;

    function setupBlogNotification() {
        const blogLi = document.querySelector<HTMLElement>('[data-blog-link]');
        if (!blogLi) return;

        const dot = blogLi.querySelector<HTMLElement>('.blog-dot');
        const latestIso = blogLi.dataset.latestBlog;

        // If the user is on /blog or /blog/*, mark as seen and bail.
        if (location.pathname.replace(/\/$/, '').startsWith('/blog')) {
            try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
            if (dot) dot.hidden = true;
            return;
        }

        if (!dot || !latestIso) return;
        const latestMs = new Date(latestIso).getTime();
        if (!Number.isFinite(latestMs)) return;

        // Visit-time freshness cap: post must be newer than 7 days right now.
        if (Date.now() - latestMs > NEW_WINDOW_MS) return;

        let lastSeenMs = 0;
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) lastSeenMs = Number(raw) || 0;
        } catch {}

        if (latestMs > lastSeenMs) {
            dot.hidden = false;
        }

        const anchor = blogLi.querySelector('a');
        anchor?.addEventListener('click', () => {
            try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
            if (dot) dot.hidden = true;
        });
    }

    setupBlogNotification();
</script>
