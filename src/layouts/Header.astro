---
interface Props {
	textColor?: 'black' | 'white';
    hide?: boolean;
}

const { textColor = 'black', hide = false } = Astro.props;

import { routes } from '../routes';
import '../styles/global.css';
import { getCollection } from 'astro:content';

const currentPage = new URL(Astro.request.url).pathname.replace(/\/$/, '').replace(/\.html$/, "");

function currentPageCheck(link) {
    const regex = new RegExp(`^${link}(/|$)`);
    return regex.test(currentPage) ? "active-link" : "";
}

function parseBlogDateFromId(id: string): Date | null {
    const m = /^(\d{4})([.\-]?)(\d{2})\2(\d{2})/.exec(id);
    if (!m) return null;
    const [, y, , mth, d] = m;
    const dt = new Date(Number(y), Number(mth) - 1, Number(d));
    return isNaN(dt.getTime()) ? null : dt;
}

// Build-time: find the latest blog post date and bake it into the HTML.
// The 7-day freshness cap is evaluated at visit time in the client script
// below, so a stale build can never show a dot for a post outside the window.
let latestBlogDateMs: number | null = null;
try {
    const blogPosts = await getCollection('blog');
    for (const p of blogPosts) {
        const fallback = parseBlogDateFromId(p.id);
        const dRaw = p.data.date ?? fallback;
        if (!dRaw) continue;
        const ms = new Date(dRaw).getTime();
        if (Number.isFinite(ms) && (latestBlogDateMs === null || ms > latestBlogDateMs)) {
            latestBlogDateMs = ms;
        }
    }
} catch {}
const latestBlogIso = latestBlogDateMs !== null ? new Date(latestBlogDateMs).toISOString() : '';

const isMonkeySection = currentPage === routes.monkey || currentPage.startsWith(routes.monkey + '/');
const isBridgeSection = currentPage === routes.bridge || currentPage.startsWith(routes.bridge + '/');

const monkeySubpages = [
    { label: 'getting started', href: routes.monkeyGettingStarted },
    { label: 'manual', href: routes.monkeyManual },
    { label: 'faq', href: routes.monkeyFaq },
    { label: 'templates', href: routes.monkeyTemplates },
    // { label: 'changelog', href: routes.monkeyChangelog },
];

import logoImg from '../assets/logo.svg';
import logoWhiteImg from '../assets/logo-white.svg';

import CartIcon from '../components/CartIcon.svelte';
import CartPopup from '../components/CartPopup.svelte';
import NewsletterButton from '../components/NewsletterButton.svelte';
import NewsletterPopup from '../components/NewsletterPopup.svelte';
---

<header class={textColor == 'white' ? 'text-white' : 'text-black'} {...(hide ? { hide: true } : {})}>
    <div class="logo">
        <a href={routes.home}><img src={textColor == 'white' ? logoWhiteImg.src : logoImg.src} /></a>
        <svg class="flag" width="16" height="12" viewBox="0 0 22 16" xmlns="http://www.w3.org/2000/svg" aria-label="Made in Norway" role="img">
            <rect width="22" height="16" fill="#BA0C2F"/>
            <rect x="6" width="4" height="16" fill="#fff"/>
            <rect y="6" width="22" height="4" fill="#fff"/>
            <rect x="7" width="2" height="16" fill="#00205B"/>
            <rect y="7" width="22" height="2" fill="#00205B"/>
        </svg>
    </div>

    <nav class="island">
        <ul>
            <li class:list={['monkey-item', currentPageCheck(routes.monkey)]}>
                <a href={routes.monkey}>MON<b>KEY</b></a>
                {isMonkeySection && (
                    <ul class="monkey-sub-list">
                        {monkeySubpages.map(p => (
                            <li class={currentPageCheck(p.href)}>
                                <a href={p.href}>{p.label}</a>
                            </li>
                        ))}
                    </ul>
                )}
            </li>
            <li class:list={['bridge', currentPageCheck(routes.bridge)]}>
                <a href={routes.bridge}>BRIDGE</a>
                {isBridgeSection && <span class="bridge-note">new device coming</span>}
            </li>
            <li class={currentPageCheck(routes.kd3)}>
                <a href={routes.kd3}>KD-3</a>
            </li>
        </ul>
    </nav>

    <aside class="side">
        <div class="cart-mount">
            <CartIcon client:load />
        </div>
        <ul class="side-list">
            <li class={currentPageCheck(routes.about)}>
                <a href={routes.about}>about</a>
            </li>
            <li class={currentPageCheck(routes.blog)} data-blog-link data-latest-blog={latestBlogIso}>
                <a href={routes.blog}>blog{latestBlogIso && <span class="blog-dot" hidden></span>}</a>
            </li>
            <li class={currentPageCheck(routes.support)}>
                <a href={routes.support}>support</a>
            </li>
            <!-- <li class={currentPageCheck(routes.deviceUtility)}>
                <a href={routes.deviceUtility}>device utility</a>
            </li> -->
            <!-- <li class={currentPageCheck(routes.midiConnect)}>
                <a href={routes.midiConnect}>MIDI connect</a>
            </li> -->
        </ul>
        <ul class="side-icons">
            <li>
                <a href={routes.wavyDiscord} target="_blank" aria-label="Discord">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>
                    </svg>
                </a>
            </li>
            <li>
                <a href={routes.wavyIndstagram} target="_blank" aria-label="Instagram">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
                    </svg>
                </a>
            </li>
            <li>
                <NewsletterButton client:load />
            </li>
        </ul>
    </aside>
    <CartPopup client:load />
    <NewsletterPopup client:load />
</header>

<style>
    header {
        padding: 24px 24px 20px;
        width: 100%;

        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: start;
        gap: 24px;

        transition: all 0.3s;
        height: auto;
    }

    header[hide] {
        height: 0;
        padding-top: 0;
        padding-bottom: 0;
        overflow: hidden;
    }

    .text-black {
        color: black;
    }
    .text-white {
        color: rgba(255, 255, 255, 0.8);
    }

    .logo {
        grid-column: 1;
    }

    .logo img {
        display: block;
    }

    .logo .flag {
        display: block;
        margin-top: 4px;
        opacity: 0.85;
    }

    .side {
        grid-column: 3;
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: flex-end;
        text-align: right;
    }

    .cart-mount {
        display: flex;
    }

    .side-list {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 14px;
        font-weight: 300;
        line-height: 1.4;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .side-icons {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .side-icons a {
        display: inline-flex;
        opacity: 0.7;
    }

    .side-icons a:hover {
        opacity: 1;
    }

    .island {
        grid-column: 2;
        justify-self: center;
    }

    .island > ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 28px;
        align-items: baseline;
        font-size: 16px;
        font-weight: 400;
    }

    .bridge {
        position: relative;
        line-height: 1.1;
    }

    .bridge-note {
        position: absolute;
        top: 100%;
        left: 0;
        margin-top: 8px;
        font-size: 11px;
        opacity: 0.5;
        white-space: nowrap;
        pointer-events: none;
    }

    .monkey-item {
        position: relative;
        line-height: 1.1;
    }

    .monkey-sub-list {
        position: absolute;
        top: 100%;
        left: 0;
        list-style: none;
        padding: 0;
        margin: 8px 0 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 11px;
        text-align: left;
        white-space: nowrap;
    }

    .monkey-sub-list a {
        opacity: 0.5;
    }

    .monkey-sub-list .active-link a {
        opacity: 1;
        font-weight: 400;
        text-decoration: underline;
    }

    li {
        white-space: nowrap;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    .active-link > a {
        text-decoration: underline;
    }

    @media (max-width: 640px) {
        header {
            grid-template-columns: auto 1fr;
            grid-template-rows: auto auto;
            gap: 14px 16px;
        }

        .logo {
            grid-column: 1;
            grid-row: 1;
        }

        .island {
            grid-column: 2;
            grid-row: 1;
            justify-self: center;
        }

        .side {
            grid-column: 1 / -1;
            grid-row: 2;
        }

        .island > ul {
            gap: 20px;
            font-size: 16px;
        }
    }

    [data-blog-link] a {
        position: relative;
    }

    .blog-dot {
        position: absolute;
        top: 1px;
        right: -8px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #ff7a1a;
    }

    .blog-dot[hidden] {
        display: none;
    }
</style>

<script>
    const STORAGE_KEY = 'wavy_blog_last_seen';
    const NEW_WINDOW_MS = 7 * 24 * 60 * 60 * 1000;

    function setupBlogNotification() {
        const blogLi = document.querySelector<HTMLElement>('[data-blog-link]');
        if (!blogLi) return;

        const dot = blogLi.querySelector<HTMLElement>('.blog-dot');
        const latestIso = blogLi.dataset.latestBlog;

        // If the user is on /blog or /blog/*, mark as seen and bail.
        if (location.pathname.replace(/\/$/, '').startsWith('/blog')) {
            try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
            if (dot) dot.hidden = true;
            return;
        }

        if (!dot || !latestIso) return;
        const latestMs = new Date(latestIso).getTime();
        if (!Number.isFinite(latestMs)) return;

        // Visit-time freshness cap: post must be newer than 7 days right now.
        if (Date.now() - latestMs > NEW_WINDOW_MS) return;

        let lastSeenMs = 0;
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw) lastSeenMs = Number(raw) || 0;
        } catch {}

        if (latestMs > lastSeenMs) {
            dot.hidden = false;
        }

        const anchor = blogLi.querySelector('a');
        anchor?.addEventListener('click', () => {
            try { localStorage.setItem(STORAGE_KEY, String(Date.now())); } catch {}
            if (dot) dot.hidden = true;
        });
    }

    setupBlogNotification();
</script>
