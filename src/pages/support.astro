---
import PageLayout from '~/layouts/PageLayout.astro';
import { routes } from '~/routes';
---

<PageLayout title="Support - Wavy Industries" heading="Support">
    <section class="columns">
        <div>
            <h2>MON<b>KEY</b></h2>
            <ul>
                <li><a href={routes.monkeyGettingStarted}>getting started</a></li>
                <li><a href={routes.monkeyManual}>manual</a></li>
                <li><a href={routes.monkeyFaq}>faq</a></li>
                <li><a href={routes.monkeyTemplates}>templates</a></li>
            </ul>
        </div>

        <!-- BRIDGE is unannounced.
        <div>
            <h2>BRIDGE</h2>
            <ul>
                <li class="none">&mdash;</li>
            </ul>
        </div>
        -->

        <div>
            <h2>KD-3</h2>
            <ul>
                <li class="none">&mdash;</li>
            </ul>
        </div>
    </section>

    <section class="columns">
        <div>
            <h2>tools</h2>
            <ul>
                <li><a href={routes.deviceUtility}>device utility</a></li>
                <li><a href={routes.midiConnect}>MIDI connect</a></li>
            </ul>
        </div>

        <div>
            <h2>contact</h2>
            <ul>
                <li><a href={routes.wavyDiscord} target="_blank">join discord</a></li>
                <li><a id="contact-email">email us</a></li>
                <li><a href={routes.wavyIndstagram} target="_blank">instagram</a></li>
            </ul>
        </div>
    </section>
</PageLayout>

<style>
.columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
}

.none {
    color: #bbb;
}

@media (max-width: 640px) {
    .columns {
        grid-template-columns: 1fr;
        gap: 28px;
    }
}
</style>

<script>
function setupContactEmail() {
    const link = document.getElementById('contact-email') as HTMLAnchorElement;
    const p1 = "hell";
    const p2 = "o";
    link.href = "mai" + "lto:" + p1 + p2 + "@" + "wavyindustries.com";
}
setTimeout(setupContactEmail, 100);
</script>
