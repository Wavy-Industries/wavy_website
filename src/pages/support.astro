---
import '~/styles/global.css';
import Layout from '~/layouts/Layout.astro';
import Header from '~/layouts/Header.astro';
import Footer from '~/layouts/Footer.astro';
import { routes } from '~/routes';
---

<Layout title="Support - Wavy Industries">
    <main>
        <Header />
        <section class="support">
            <article>
                <h1>Support</h1>

                <div class="columns products">
                    <div class="column">
                        <h2>MON<b>KEY</b></h2>
                        <ul>
                            <li><a href={routes.monkeyGettingStarted}>getting started</a></li>
                            <li><a href={routes.monkeyManual}>manual</a></li>
                            <li><a href={routes.monkeyFaq}>faq</a></li>
                            <li><a href={routes.monkeyTemplates}>templates</a></li>
                        </ul>
                    </div>

                    <!-- BRIDGE is unannounced.
                    <div class="column">
                        <h2>BRIDGE</h2>
                        <ul>
                            <li class="none">&mdash;</li>
                        </ul>
                    </div>
                    -->

                    <div class="column">
                        <h2>KD-3</h2>
                        <ul>
                            <li class="none">&mdash;</li>
                        </ul>
                    </div>
                </div>

                <div class="columns">
                    <div class="column">
                        <h2>tools</h2>
                        <ul>
                            <li><a href={routes.deviceUtility}>device utility</a></li>
                            <li><a href={routes.midiConnect}>MIDI connect</a></li>
                        </ul>
                    </div>

                    <div class="column">
                        <h2>contact</h2>
                        <ul>
                            <li><a href={routes.wavyDiscord} target="_blank">discord</a></li>
                            <li><a id="contact-email">email</a></li>
                            <li><a href={routes.wavyIndstagram} target="_blank">instagram</a></li>
                        </ul>
                    </div>
                </div>
            </article>
        </section>
        <Footer />
    </main>
</Layout>

<style>
main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #fff;
}

.support {
    width: 100%;
    padding: 0 24px;
    flex-grow: 1;
}

.support article {
    margin: 0 auto;
    max-width: 800px;
    width: 100%;
    padding: 40px 0 80px;
}

h1 {
    font-size: 36px;
    font-weight: 300;
    margin: 0 0 48px;
    color: #111;
}

.columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 0 0 56px;
}

h2 {
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #111;
    margin: 0 0 14px;
}

.column ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.column li {
    font-size: 13px;
    line-height: 1.5;
}

.column a {
    color: #111;
    text-decoration: none;
    font-style: normal;
    cursor: pointer;
}

.column a:hover {
    text-decoration: underline;
}

.none {
    color: #bbb;
}

@media (max-width: 640px) {
    .support {
        padding: 0 16px;
    }

    .support article {
        padding: 28px 0 60px;
    }

    h1 {
        font-size: 28px;
        margin-bottom: 36px;
    }

    .columns {
        grid-template-columns: 1fr;
        gap: 28px;
        margin-bottom: 28px;
    }
}
</style>

<script>
function setupContactEmail() {
    const link = document.getElementById('contact-email') as HTMLAnchorElement;
    const p1 = "hell";
    const p2 = "o";
    link.href = "mai" + "lto:" + p1 + p2 + "@" + "wavyindustries.com";
}
setTimeout(setupContactEmail, 100);
</script>
