---
import '~/styles/global.css';
import { routes } from '~/routes';
import Layout from '~/layouts/Layout.astro';
import Header from '~/layouts/Header.astro';
import Footer from '~/layouts/Footer.astro';
import LinkButton from '~/components/LinkButton.astro';

// images
import midiConnectMacImg from '~/assets/midi_connect/screenshot-mac.png';
import midiConnectWinImg from '~/assets/midi_connect/screenshot-win.png';


// const ratings = [
//     {
//         rating: 5,
//         title: "Thanks for existing",
//         text: "I would buy you a coffee, share a link",
//         date: "2025-11-07"
//     }
// ]
---

<Layout title="MIDI Connect - Wavy Industries">
	<main>
		<Header textColor="white" />
		<section class="hero">
			<div class="hero-inner">
				<h1>MIDI Connect</h1>
				<p class="tagline">🛑✋ STOP menu-diving each time you want to connect to a Bluetooth MIDI device on macOS or Windows</p>
				<div class="hero-actions">
					<LinkButton href={routes.midiConnectAppStore} type="highlight" theme="dark" id="macos-download">Download for macOS</LinkButton>
					<LinkButton href={routes.midiConnectWindowsInstaller} type="default" theme="dark" download id="windows-download">Download for Windows (experimental)</LinkButton>
				</div>
			</div>
		</section>

		<div class="hero-image hero-image--side-by-side">
			<img class="hero-image__mac" src={midiConnectMacImg.src} alt="MIDI Connect for macOS" />
			<img class="hero-image__win" src={midiConnectWinImg.src} alt="MIDI Connect for Windows" />
		</div>

		<section class="intro">
			<div class="container">
				<div class="intro-content">
					<p>We developed this simple macOS and Windows app to make it super easy for you to manage your Bluetooth MIDI devices. And it's not just for Wavy devices, it's for any Bluetooth MIDI device.</p>
					<p><a href="https://github.com/Wavy-Industries/MIDI-Connect-windows">The Windows version of MIDI Connect is open source.</a></p>
				</div>
			</div>
		</section>
	</main>

	<div id="windows-disclaimer" class="disclaimer" hidden>
		<div class="disclaimer-card" role="dialog" aria-modal="true" aria-labelledby="disclaimer-title">
			<h2 id="disclaimer-title">Heads up</h2>
			<p>Microsoft is currently reworking the MIDI implementation on Windows. You are likely to experience problems during setup and use.</p>
			<p>Do you want to continue with the download?</p>
			<div class="disclaimer-actions">
				<button type="button" class="disclaimer-btn disclaimer-btn--secondary" id="disclaimer-cancel">Cancel</button>
				<button type="button" class="disclaimer-btn disclaimer-btn--primary" id="disclaimer-continue">Continue download</button>
			</div>
		</div>
	</div>

    <Footer variant="dark" />
</Layout>

<script>
	import { track, TRACKING_EVENT_TYPES } from '~/lib/api/tracking.js';

	const trigger = document.getElementById('windows-download') as HTMLAnchorElement | null;
	const macTrigger = document.getElementById('macos-download') as HTMLAnchorElement | null;
	const modal = document.getElementById('windows-disclaimer');
	const cancelBtn = document.getElementById('disclaimer-cancel');
	const continueBtn = document.getElementById('disclaimer-continue');

	let acknowledged = false;

	function openModal() {
		if (!modal) return;
		modal.hidden = false;
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (!modal) return;
		modal.hidden = true;
		document.body.style.overflow = '';
	}

	macTrigger?.addEventListener('click', () => {
		track(TRACKING_EVENT_TYPES.download, { kind: 'app', name: 'midi-connect', platform: 'macos' });
	});

	trigger?.addEventListener('click', (e) => {
		if (acknowledged) return;
		e.preventDefault();
		openModal();
	});

	cancelBtn?.addEventListener('click', closeModal);

	continueBtn?.addEventListener('click', () => {
		acknowledged = true;
		closeModal();
		track(TRACKING_EVENT_TYPES.download, { kind: 'app', name: 'midi-connect', platform: 'windows' });
		trigger?.click();
	});

	modal?.addEventListener('click', (e) => {
		if (e.target === modal) closeModal();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
	});
</script>

<style>
main {
	background-color: #000;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

:global(html),
:global(body) {
	background-color: #000;
}

img {
	width: 100%;
}

.container {
	max-width: 1200px;
	margin: 0 auto;
	padding: 0 24px;
}

.hero {
	width: 100%;
	padding: 40px 24px 32px;
	color: #f0f0f0;
}

.hero-inner {
	max-width: 1200px;
	margin: 0 auto;
}

h1 {
	margin: 0 0 8px 0;
	font-weight: 300;
	font-size: 64px;
	line-height: 1.1;
}

.tagline {
	font-size: 18px;
	font-weight: 300;
	color: #bbb;
	margin: 0 0 16px 0;
	line-height: 1.4;
}

.hero-actions {
	display: flex;
	flex-wrap: wrap;
	gap: 12px;
}

.hero-image {
	width: 100%;
	padding: 50px 10%;
}

.hero-image--side-by-side {
	padding: 24px 6%;
	display: flex;
	gap: 24px;
	align-items: center;
	justify-content: center;
}

.hero-image__mac,
.hero-image__win {
	width: 100%;
	height: auto;
	object-fit: contain;
	object-position: center;
	max-width: 50%;
}

.intro {
	width: 100%;
	padding: 48px 0;
}

.intro-content {
	max-width: 680px;
	margin: 0 auto;
	text-align: center;
	font-weight: 300;
	color: #ddd;
}

.intro-content p {
	font-size: 17px;
	line-height: 1.6;
	margin: 0 0 20px 0;
	color: #d0d0d0;
}

.intro-content p:last-child {
	margin-bottom: 0;
}

@media (max-width: 768px) {
	h1 {
		font-size: 48px;
	}

	.tagline {
		font-size: 16px;
	}

	.container {
		padding: 0 20px;
	}

	.hero {
		padding: 32px 20px 24px;
	}

	.intro {
		padding: 32px 0;
	}

	.hero-image--side-by-side {
		flex-direction: column;
		padding: 16px 6%;
	}

	.hero-image__mac,
	.hero-image__win {
		max-width: 100%;
	}
}

.disclaimer {
	position: fixed;
	inset: 0;
	background-color: rgba(0, 0, 0, 0.75);
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 24px;
	z-index: 1000;
}

.disclaimer[hidden] {
	display: none;
}

.disclaimer-card {
	background-color: #111;
	color: #f0f0f0;
	border: 1px solid #2a2a2a;
	max-width: 480px;
	width: 100%;
	padding: 28px;
}

.disclaimer-card h2 {
	margin: 0 0 12px 0;
	font-size: 22px;
	font-weight: 400;
}

.disclaimer-card p {
	font-size: 15px;
	line-height: 1.5;
	color: #cfcfcf;
	margin: 0 0 12px 0;
	font-weight: 300;
}

.disclaimer-actions {
	display: flex;
	justify-content: flex-end;
	gap: 8px;
	margin-top: 20px;
	flex-wrap: wrap;
}

.disclaimer-btn {
	font-size: 14px;
	font-weight: 400;
	padding: 6px 12px;
	border: 1px solid #ccc;
	cursor: pointer;
	font-family: inherit;
}

.disclaimer-btn--secondary {
	background-color: transparent;
	color: #ddd;
	border-color: #444;
}

.disclaimer-btn--secondary:hover {
	background-color: #1c1c1c;
}

.disclaimer-btn--primary {
	background-color: white;
	color: black;
}

.disclaimer-btn--primary:hover {
	background-color: #f0f0f0;
}

</style>
