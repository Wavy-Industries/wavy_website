---
import PageLayout from '~/layouts/PageLayout.astro';
import { routes } from '~/routes';
---

<PageLayout title="Downloads - Wavy Industries" heading="Downloads">
	<section>
		<h2>MON<b>KEY</b></h2>
		<ul>
			<li><a href={routes.monkeyTemplates}>DAW templates</a></li>
			<li><a href={routes.deviceUtility}>device utility</a> <span class="meta">firmware updates and samples</span></li>
			<li><a href={routes.monkeyManual}>manual</a></li>
		</ul>
	</section>

	<section>
		<h2>tools</h2>
		<ul>
			<li><a href={routes.midiConnectAppStore} target="_blank">MIDI Connect for macOS</a></li>
			<li><a href={routes.midiConnectWindowsInstaller} download>MIDI Connect for Windows</a> <span class="meta">experimental</span></li>
		</ul>
	</section>
</PageLayout>

<style>
	li {
		display: flex;
		gap: 10px;
		align-items: baseline;
	}

	.meta {
		color: #bbb;
	}

	@media (max-width: 640px) {
		li {
			flex-direction: column;
			gap: 2px;
		}
	}
</style>
