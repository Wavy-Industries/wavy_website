---
import PageLayout from '~/layouts/PageLayout.astro';

const retailers = [
	{
		name: 'NoiseTone Synthesizer Store',
		country: 'CN',
		url: 'https://noisetone.store/',
	},
	{
		name: 'Filter Musikk',
		country: 'NO',
		url: 'https://filtermusikk.no/produkt/wavy-industries-monkey',
	},
];

const pressKit = [
	{ name: 'Wavy logo', contents: 'SVG, black + white', href: '/assets/press-kit/wavy-logo.zip' },
	{ name: 'MONKEY', contents: 'Renders, photos, packaging, 2D layout', href: '/assets/press-kit/monkey.zip' },
];
---

<PageLayout
	title="Partners - Wavy Industries"
	description="Where to buy Wavy Industries products and how to become a retailer."
	heading="Partners"
>
	<section>
		<h2>retailers</h2>
		<p>Buy Wavy Industries products from an authorized retailer.</p>
		<ul>
			{retailers.map(r => (
				<li>
					<a href={r.url} target="_blank" rel="noopener">{r.name}</a>
					<span class="meta">{r.country}</span>
				</li>
			))}
		</ul>
	</section>

	<section>
		<h2>become a partner</h2>
		<p>For retailers, educators and collaborators. Enter your email and we'll send you a link to continue.</p>

		<div class="partners-form" id="partners-form">
			<form class="form" novalidate>
				<input
					type="email"
					name="email"
					required
					autocomplete="email"
					placeholder="email@retailer.com"
				/>
				<button type="submit">Continue</button>
			</form>
			<p class="error" hidden></p>
		</div>

		<div class="partners-success" hidden>
			<p>Check your email — we've sent you a link to continue.</p>
		</div>
	</section>

	<section>
		<h2>press kit</h2>
		<p>Logos and product images for press, retailers and partners. Each download is a ZIP.</p>
		<ul>
			{pressKit.map(a => (
				<li>
					<a href={a.href} download>{a.name}</a>
					<span class="meta">{a.contents}</span>
				</li>
			))}
		</ul>
	</section>
</PageLayout>

<style>
li {
	display: flex;
	gap: 10px;
	align-items: baseline;
}

.meta {
	color: #bbb;
}

.form {
	display: flex;
	align-items: stretch;
	height: 40px;
	max-width: 380px;
}

input {
	flex-grow: 1;
	min-width: 0;
	border: 1px solid #ccc;
	border-right: 0;
	padding: 0 12px;
	font-size: 13px;
	color: #111;
	background: #fff;
	outline: none;
	font-family: inherit;
}

input::placeholder {
	color: #bbb;
}

input:focus {
	border-color: #111;
}

button {
	border: 0;
	background: #111;
	color: #fff;
	font-size: 13px;
	font-weight: 500;
	letter-spacing: 0.02em;
	padding: 0 20px;
	cursor: pointer;
	font-family: inherit;
}

button:hover:not(:disabled) {
	background: var(--accent-color);
}

input:disabled,
button:disabled {
	color: #888;
	background: #f5f5f5;
	cursor: default;
}

.error {
	margin: 8px 0 0;
	color: #b3261e;
}

@media (max-width: 640px) {
	li {
		flex-direction: column;
		gap: 2px;
	}

	.form {
		max-width: none;
	}
}
</style>

<script>
	import { requestPartnerAccess } from '~/lib/api/partners.js';

	const root = document.getElementById('partners-form');
	const success = document.querySelector<HTMLElement>('.partners-success');
	const form = root?.querySelector<HTMLFormElement>('.form');
	const input = root?.querySelector<HTMLInputElement>('input[type=email]');
	const button = root?.querySelector<HTMLButtonElement>('button[type=submit]');
	const error = root?.querySelector<HTMLElement>('.error');

	if (root && success && form && input && button && error) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = input.value.trim();
			if (!email) return;
			error.hidden = true;
			error.textContent = '';
			input.disabled = true;
			button.disabled = true;

			const result = await requestPartnerAccess({ email });

			if (result.ok) {
				root.hidden = true;
				success.hidden = false;
				return;
			}

			input.disabled = false;
			button.disabled = false;

			if (result.reason === 'rate_limited') {
				error.textContent = 'Too many requests, please wait a moment.';
			} else if (result.reason === 'validation') {
				const fieldErrors = result.errors && (result.errors.email || result.errors.Email);
				const message = Array.isArray(fieldErrors) ? fieldErrors[0] : fieldErrors;
				error.textContent = message || 'Please enter a valid email address.';
			} else {
				error.textContent = 'Something went wrong. Please try again later.';
			}
			error.hidden = false;
		});
	}
</script>
