---
import '~/styles/global.css';
import Layout from "~/layouts/Layout.astro";
import Header from "~/layouts/Header.astro";
import StockSubscribe from '~/components/StockSubscribe.astro';

import arrowRightImg from '~/assets/icons/arrow.right.svg';
import { routes } from '~/routes';
---

<Layout title="Cart - Wavy Industries">
  <main class="cart-page">
    <Header />
    <div id="checkout-loading" class="page-loading">
      <div class="spinner" aria-hidden="true"></div>
    </div>

    <section id="checkout-empty" class="hidden">
      <div class="content empty-state">
        <h2>Your cart is empty</h2>
        <p>Browse our products to add something to your cart.</p>
        <a class="empty-cta" href={routes.monkey}>Visit MONKEY</a>
      </div>
    </section>

    <section id="checkout-section" class="hidden">
      <h1 class="checkout-title">Cart</h1>
      <div class="card-stack">
        <div id="line-items"></div>
        <hr />
        <div class="content totals-card">
          <div class="totals-row region-row">
            <small id="region-label" class="region-label"></small>
          </div>
          <div class="totals-row info-row">
            <span>Shipping</span>
            <span class="info-value">Worldwide express. 4-12 business days from Norway</span>
          </div>
          <div class="totals-row info-row">
            <span id="tax-label">Taxes</span>
            <span id="tax-amount" class="info-value">Calculating…</span>
          </div>
          <div class="totals-row subtotal-row">
            <span>Subtotal</span>
            <span id="total-price" class="totals-value">Loading…</span>
          </div>
        </div>
      </div>

      <aside id="preorder-disclosure" class="preorder-note hidden">
        <span class="preorder-tag">Pre-order</span>
        <div class="preorder-text">
          <p><b>Estimated shipping: Q3 2026.</b> Your order will not ship until every item in your cart is available. We will keep you up to date by email.</p>
          <p>You can cancel for a full refund any time before shipment. Thank you for supporting our pre-order.</p>
        </div>
      </aside>

      <div id="buy-now-wrapper">
        <label class="terms-check">
          <input type="checkbox" id="terms-accept" />
          <span>I have read and agree to the <a target="_blank" href={routes.termsAndConditions}>terms &amp; conditions</a>.</span>
        </label>
        <div class="cart-actions">
          <a class="back-link" href={routes.home}><img src={arrowRightImg.src} alt="" /> Back to shopping</a>
          <button id="buy-now-button" class="chechout-button" disabled>Continue to checkout</button>
        </div>
        <p id="buy-error" class="shipping-info hidden"></p>
        <div class="trust-strip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>Secure checkout via Shopify · Cards, Apple Pay, Google Pay, PayPal</span>
        </div>
      </div>

      <div id="stock-notify-form" class="content hidden">
        <StockSubscribe />
      </div>
    </section>

    <script src="../scripts/checkout.js"></script>
  </main>
</Layout>


<style is:global>
/*
 * Styles are `is:global` because line items are injected at runtime by
 * `scripts/checkout.js` (no `data-astro-cid-*` on those nodes, so Astro's
 * scoped CSS can't reach them). Every rule below is prefixed with
 * `.cart-page` so it only applies to elements inside `<main class="cart-page">`.
 */
#preorder-disclosure {
  background-color: #f2f3ec;
  padding: 20px;
  max-width: 640px;
  width: 100%;
  margin: 0px;
}

.cart-page main {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

#checkout-section,
.cart-page #checkout-empty {
  margin: 24px auto 60px;
  width: 100%;
  max-width: 640px;
  padding: 0 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  box-sizing: border-box;
}

.cart-page .page-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 60vh;
  text-align: center;
  color: #1f1f1f;
}

.cart-page .spinner {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 2px solid #ffffff;
  border-top-color: #000000;
  animation: spin 0.5s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.cart-page .banner {
  background-color: #d5d5d5;
  padding: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-page .banner img {
  display: block;
  height: 32px;
  width: auto;
}

.cart-page .card-stack {
  display: flex;
  flex-direction: column;
}

.cart-page hr {
  border: 0;
  margin: 0;
  height: 1px;
  background: #d5d5d5;
}

.cart-page .content {
  background-color: #F5F5F5;
  padding: 20px;
}

.cart-page #line-items {
  display: flex;
  flex-direction: column;
}

.cart-page #line-items > .line-item:not(:first-child) {
  border-top: 1px solid #d5d5d5;
}

.cart-page .line-item {
  background-color: #F5F5F5;
  padding: 14px 20px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px 16px;
}

.cart-page .line-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1 1 auto;
  min-width: 0;
  flex-wrap: wrap;
}

.cart-page .line-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 0 1 auto;
  margin-left: auto;
  flex-wrap: wrap;
}

.cart-page .line-icon {
  flex: 0 0 auto;
  width: 32px;
  height: 32px;
  object-fit: contain;
  display: block;
}

.cart-page .line-name-wrap {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.cart-page .line-name {
  font-weight: 600;
  font-size: 15px;
}

.cart-page .preorder-tag {
  display: inline-block;
  padding: 2px 6px;
  background-color: #ffcc00;
  color: #1a1a1a;
  font-size: 10px;
  font-weight: 600;
  font-style: normal;
  border-radius: 3px;
  letter-spacing: 0.3px;
  white-space: nowrap;
}

.cart-page .preorder-note {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: -8px 4px 0;
  padding: 0;
  background: transparent;
  font-size: 12px;
  font-style: normal;
  color: #777;
  line-height: 1.5;
}

.cart-page .preorder-note .preorder-tag {
  flex: 0 0 auto;
  margin-top: 1px;
}

.cart-page .preorder-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cart-page .preorder-text p {
  margin: 0;
}

.cart-page .preorder-text b {
  color: #555;
}

.cart-page .checkout-title {
  margin: 0;
  font-weight: 300;
  font-size: 32px;
}

.cart-page .line-price {
  flex: 0 0 auto;
  font-size: 13px;
  color: #555;
  font-variant-numeric: tabular-nums;
}

.cart-page .qty-controls {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.cart-page .qty-button {
  border: 1px solid #ccc;
  background-color: #fff;
  padding: 2px 10px;
  cursor: pointer;
  font-size: 16px;
  line-height: 1;
  font-family: inherit;
}

.cart-page .qty-button:hover:not(:disabled) {
  background-color: #f0f0f0;
}

.cart-page .qty-button:disabled {
  cursor: default;
  opacity: 0.5;
}

.cart-page .qty-value {
  min-width: 1.5ch;
  text-align: center;
  font-variant-numeric: tabular-nums;
  font-size: 14px;
}

.cart-page .line-total {
  flex: 0 0 auto;
  min-width: 64px;
  text-align: right;
  font-size: 14px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.cart-page .line-remove {
  flex: 0 0 auto;
  background: none;
  border: 0;
  color: #888;
  cursor: pointer;
  font-size: 12px;
  font-style: normal;
  text-decoration: underline;
  padding: 0;
  font-family: inherit;
}

.cart-page .line-remove:hover {
  color: #111;
}

.cart-page .totals-card {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 14px;
}

.cart-page .totals-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
}

.cart-page .info-row {
  font-size: 12px;
  color: #555;
}

.cart-page .info-value {
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.cart-page .subtotal-row {
  border-top: 1px solid #d5d5d5;
  margin-top: 8px;
  padding-top: 10px;
  font-size: 16px;
  font-weight: 600;
  color: #111;
}

.cart-page .totals-value {
  font-variant-numeric: tabular-nums;
}

.cart-page .region-row {
  margin-bottom: 4px;
}

.cart-page .region-label {
  font-size: 11px;
  color: #777;
}

.cart-page #buy-now-wrapper {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cart-page .terms-check {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 13px;
  color: #333;
  cursor: pointer;
}

.cart-page .terms-check input {
  margin-top: 2px;
  cursor: pointer;
}

.cart-page .terms-check a {
  text-decoration: underline;
  font-style: normal;
}

.cart-page .trust-strip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 12px;
  color: #555;
  font-style: normal;
}

.cart-page .trust-strip svg {
  flex: 0 0 auto;
  color: #555;
}

.cart-page .cart-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.cart-page .back-link {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 300;
  font-size: 13px;
  text-decoration: underline;
  font-style: normal;
  color: inherit;
  white-space: nowrap;
}

.cart-page .back-link img {
  height: 10px;
  transform: rotate(180deg);
}

.cart-page .chechout-button {
  background-color: #5A88FF;
  color: white;
  flex: 1 1 auto;
  border: none;
  padding: 20px 24px;
  font-weight: bold;
  font-size: 16px;
  text-align: center;
  cursor: pointer;
  font-family: inherit;
}

.cart-page .chechout-button:hover:not(:disabled) {
  background-color: #4378ff;
}

.cart-page .chechout-button:disabled {
  cursor: default;
  opacity: 0.7;
}

.cart-page .shipping-info {
  font-size: 12px;
  font-style: italic;
}

.cart-page .terms {
  text-align: center;
  margin: 0;
}

.cart-page .empty-state {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 40px 20px;
}

.cart-page .empty-state h2 {
  margin: 0;
  font-weight: 300;
  font-size: 28px;
}

.cart-page .empty-state p {
  margin: 0;
  color: #555;
  font-size: 14px;
}

.cart-page .empty-cta {
  margin-top: 8px;
  background-color: rgb(8, 76, 207);
  color: white;
  border: 1px solid #a0bee9;
  padding: 8px 14px;
  text-decoration: none;
  font-style: normal;
  font-size: 14px;
}

.cart-page .empty-cta:hover {
  background-color: blue;
  text-decoration: none;
}

.cart-page .hidden {
  display: none !important;
}
</style>
