---
import PageLayout from '~/layouts/PageLayout.astro';
import { routes } from '~/routes';
---

<PageLayout
	title="About - Wavy Industries"
	description="Wavy Industries is a small Norwegian company designing portable music devices."
	heading="About"
>
	<section>
		<p>CHAOS ORDER CREATIVITY EXPLORATION MYSTIQUE WONDER DISCOVERY UNUSUAL ADVENTURE FOCUS BALANCE TASTE BELIEF WHATEVER ART MOMENT EXPRESS PROCESS BEAUTY.</p>
		<p>We're based in Oslo Norway.</p>
	</section>

	<section>
		<h2>get in touch</h2>
		<ul>
			<li><a href={routes.wavyDiscord} target="_blank">Wavy Discord</a> <span class="meta">the fastest place to reach us and the community</span></li>
			<li><a href={routes.support}>Support</a> <span class="meta">help, contact, and direct email</span></li>
			<li><a href="#" id="about-newsletter-trigger">Newsletter</a> <span class="meta">new releases and other updates</span></li>
		</ul>
		<p>Reach our founder <i>Rein Gundersen Bentdal</i> directly at <a href="mailto:rein@wavyindustries.com">rein@wavyindustries.com</a>.</p>
	</section>

	<section>
		<h2>company</h2>
		<p>
			Wavy Industries AS<br />
			Org. nr. 935955335<br />
			Rosteds gate 15a, 0178 Oslo, Norway
		</p>
	</section>
</PageLayout>

<style>
	li {
		display: flex;
		gap: 10px;
		align-items: baseline;
	}

	.meta {
		color: #bbb;
	}

	@media (max-width: 640px) {
		li {
			flex-direction: column;
			gap: 2px;
		}
	}
</style>

<script>
import { openNewsletter } from "~/lib/state/newsletter.svelte";

document.getElementById("about-newsletter-trigger")?.addEventListener("click", (e) => {
	e.preventDefault();
	openNewsletter("about_popup");
});
</script>
